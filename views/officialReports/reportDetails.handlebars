<h1>Official Report Details</h1>

<div class="official-report-details">
  <p>
    <strong>NYC Complaint Number:</strong>
    {{report.nycComplaintNumber}}
  </p>

  <p>
    <strong>Category:</strong>
    {{report.category}}
  </p>

  <p>
    <strong>Crime Type:</strong>
    {{report.crimeType}}
  </p>

  <p>
    <strong>Crime Description:</strong>
    {{report.crimeDescription}}
  </p>

  <p>
    <strong>Approximate Address:</strong>
    {{report.approximateAddress}}
  </p>

  <p>
    <strong>Borough:</strong>
    {{report.borough}}
  </p>

  <p>
    <strong>Precinct:</strong>
    {{report.precinct}}
  </p>

  <p>
    <strong>Law Category:</strong>
    {{report.lawCategory}}
  </p>

  <p>
    <strong>Attempted or Completed:</strong>
    {{report.attemptedOrCompleted}}
  </p>

  <p>
    <strong>Date Occurred:</strong>
    {{report.dateOccurred}}
  </p>

  <p>
    <strong>Latitude:</strong>
    {{report.latitude}}
  </p>

  <p>
    <strong>Longitude:</strong>
    {{report.longitude}}
  </p>

  <div class="page-actions">
    <a
      class="button-link"
      href="/saved-locations/create?officialReportId={{report._id}}"
    >
      Save Location
    </a>

    <button type="button" id="back-button">
      Back
    </button>
  </div>
</div>