<main class="dashboard">
  <header class="dashboard-header">
    <h1>Welcome Back</h1>
    <p>Monitor locations that matter to you and search official and community
      reports.</p>
  </header>

  <section class="dashboard-overview">
    <h2>Quick Overview</h2>

    <div class="overview-cards">
      <article class="overview-card">
        <h3>Saved Locations</h3>
        <p>{{savedLocationCount}}</p>
        <a href="/saved-locations/my-locations">View Saved Locations</a>
      </article>

      <article class="overview-card">
        <h3>My User Reports</h3>
        <p>{{userReportCount}}</p>
        <a href="/user-reports/my-reports">View My Reports</a>
      </article>

      <article class="overview-card">
        <h3>Search Complaints</h3>
        <p>Search official NYPD complaints and community reports.</p>
        <a href="/search">Search Complaints</a>
      </article>
    </div>
  </section>

  <section class="dashboard-locations">
    <div class="section-heading">
      <h2>Your Saved Locations</h2>
      <a href="/saved-locations/my-locations">View All</a>
    </div>
    <div class="saved-location-grid">
      {{#each savedLocations}}
        <article class="saved-location-card">
          <h3>{{label}}</h3>
          <p>{{address}}</p>

          {{#if tags.length}}
            <ul>
              {{#each tags}}
                <li>{{this}}</li>
              {{/each}}
            </ul>
          {{else}}
            <p>No tags</p>
          {{/if}}

          <a href="/saved-locations/{{_id}}">View Details</a>
        </article>
      {{/each}}

      <article class="saved-location-card add-location-card">
        <h3>Add a Location</h3>
        <p>Save an area that you want to monitor</p>
        <a href="/saved-locations/create">Save a New Location</a>
      </article>
    </div>
  </section>
</main>