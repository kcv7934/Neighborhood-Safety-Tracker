<h1>Edit User Report</h1>

<form id="edit-user-report-form" class="page-form">
    <input type="hidden" name="reportId" value="{{report._id}}"/>

    <div class="form-field">
        <label for="category">Category</label>
        <select id="category" name="category" required>
            {{#each categories}}
                <option value="{{value}}" {{#if selected}} selected {{/if}}>
                    {{value}}
                </option>
            {{/each}}
        </select>
    </div>

    <div class="form-field">
        <label for="address">Address</label>
        <input type="text" id="address" name="address" value="{{report.streetAddress}}" maxlength="50" required/>
    </div>

    <div class="form-field">
        <label for="borough">Borough</label>
        <select id="borough" name="borough" required>
            {{#each boroughs}}
                <option value="{{value}}" {{#if selected}} selected {{/if}}>
                    {{value}}
                </option>
            {{/each}}
        </select>
    </div>
    
    <div class="form-field">
        <label for="description">Description</label>
        <textarea id="description" name="description" minlength="10" maxlength="500" required>{{report.description}}</textarea>
    </div>

    <div class="form-actions">
        <button type="submit">Save Changes</button>
        <a href="/user-reports/{{report._id}}">Cancel</a>
    </div>

    <div id="form-message" class="form-message" role="alert" hidden></div>
</form>