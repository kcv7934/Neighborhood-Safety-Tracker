<h1>User Report Details</h1>

<article>
    <h2>{{report.category}}</h2>

    <p>
        Address:
        {{report.address}}
    </p>

    <p>
        Borough:
        {{report.borough}}
    </p>

    <p>
        Description:
        {{report.description}}
    </p>

    <p>
        Status:
        {{report.status}}
    </p>

    <p>
        Created:
        {{report.createdAt}}
    </p>

    <p>
        Last Updated:
        {{report.updatedAt}}
    </p>
</article>

<p>
    <a href="/user-reports/my-reports">Back to My Reports</a>
</p>