<h1>User Report Details</h1>

{{#if successMessage}}
  <p class="status-message" role="status">
    {{successMessage}}
  </p>
{{/if}}

<article class="report-details">
  <h2>{{report.category}}</h2>

  <p>
    <strong>Address:</strong>
    {{report.address}}
  </p>

  <p>
    <strong>Borough:</strong>
    {{report.borough}}
  </p>

  <p>
    <strong>Description:</strong>
    {{report.description}}
  </p>

  <p>
    <strong>Status:</strong>
    {{report.status}}
  </p>

  <p>
    <strong>Created:</strong>
    {{report.createdAt}}
  </p>

  <p>
    <strong>Last Updated:</strong>
    {{report.updatedAt}}
  </p>
</article>

<div class="page-actions">
  {{#if isOwner}}
    <a
      class="button-link"
      href="/saved-locations/create?userReportId={{report._id}}"
    >
      Save Location
    </a>
    <a class="button-link" href="/user-reports/{{report._id}}/edit">Edit Report</a>

    <button
      type="button"
      class="delete-button"
      id="delete-user-report-button"
      value="{{report._id}}"
    >Delete Report</button>
  {{/if}}

  <button type="button" id="back-button">
    Back
  </button>
</div>

{{#if isOwner}}
  <div id="delete-message" class="form-message" role="alert" hidden></div>
{{/if}}

<section class="comments-section">
  <h2>Discussion</h2>

  <form id="comment-form" class="page-form">
    <input
      type="hidden"
      id="comment-report-id"
      name="reportId"
      value="{{report._id}}"
    />

    <div class="form-field">
      <label for="comment-text">Add a Comment</label>
      <textarea
        id="comment-text"
        name="text"
        maxlength="500"
        required
      ></textarea>
    </div>

    <div class="form-actions">
      <button type="submit">Post Comment</button>
    </div>

    <div
      id="comment-form-message"
      class="form-message"
      role="alert"
      hidden
    ></div>
  </form>

  <div id="comment-list">
    {{#if comments.length}}
      {{#each comments}}
        <article class="comment-card" data-comment-id="{{_id}}">
          <p id="comment-text-{{_id}}" class="comment-text">{{text}}</p>

          <p>
            <strong>Created:</strong>
            {{createdAt}}
          </p>

          <p>
            <strong>Last Updated:</strong>
            {{updatedAt}}
          </p>

          {{#if isOwner}}
            <div class="page-actions">
              <button
                type="button"
                class="edit-comment-button"
                value="{{_id}}"
              >Edit</button>
              <button
                type="button"
                class="delete-button delete-comment-button"
                value="{{_id}}"
              >Delete</button>
            </div>
          {{/if}}
        </article>
      {{/each}}
    {{else}}
      <p>No comments yet.</p>
    {{/if}}
  </div>
</section>