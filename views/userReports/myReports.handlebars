<h1>My Reports</h1>

{{#if successMessage}}
  <p role="status">
    {{successMessage}}
  </p>
{{/if}}

<p>
  <a href="/user-reports/create">Create a New Report</a>
</p>

{{#if reports.length}}
  {{#each reports}}
    <article>
      <h2>{{category}}</h2>

      <p>
        Address:
        {{address}}
      </p>

      <p>
        Borough:
        {{borough}}
      </p>

      <p>
        Description:
        {{description}}
      </p>

      <p>
        <a href="/user-reports/{{_id}}">View Report</a>
      </p>
    </article>
  {{/each}}
{{else}}
  <p>You have not created any reports yet</p>
{{/if}}