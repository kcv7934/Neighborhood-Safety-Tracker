<h1>My Reports</h1>

{{#if successMessage}}
  <p class="status-message" role="status">
    {{successMessage}}
  </p>
{{/if}}

<p>
  <a href="/user-reports/create">Create a New Report</a>
</p>

{{#if reports.length}}
  <div class="report-list">
    {{#each reports}}
      <article class="report-card">
        <h2>{{category}}</h2>

        <p>
          <strong>Address:</strong>
          {{address}}
        </p>

        <p>
          <strong>Borough:</strong>
          {{borough}}
        </p>

        <p>
          <strong>Description:</strong>
          {{description}}
        </p>

        <p>
          <a href="/user-reports/{{_id}}">View Report</a>

          <a href="/saved-locations/create?userReportId={{_id}}">
            Save Location
          </a>
        </p>
      </article>
    {{/each}}
  </div>

{{else}}
  <p>You have not created any reports yet</p>
{{/if}}