<h1>Edit Profile</h1>

<form id="page-form" class="profile-edit" method="post" action="/user/profile/edit">
    <div class="form-field">
        <label for="firstName">First Name:</label>
        <input type="text" id="firstName" name="firstName" value="{{user.firstName}}" required>    
    </div>

    <div class="form-field">
        <label for="lastName">Last Name:</label>
        <input type="text" id="lastName" name="lastName" value="{{user.lastName}}" required>
    </div>

    <div class="form-field">
        <label for="email">Email:</label>
        <input type="email" id="email" name="email" value="{{user.email}}" required>
    </div>

    <div class="form-field">
        <label for="age">Age:</label>
        <input type="number" id="age" name="age" value="{{user.age}}" required>
    </div>

    <div class="form-field">
        <label for="state">State:</label>
        <select id="state" name="state" required>
            <option value="">Select State</option>
            {{#each states}}
                <option value="{{this.value}}" {{#if this.selected}} selected {{/if}}>
                    {{value}}
                </option>
            {{/each}}
        </select>
    </div>

    <div class="form-field">
        <label for="city">City:</label>
        <input type="text" id="city" name="city" value="{{user.city}}" required>
    </div>

    <div class="form-actions">
        <button type="submit">Save Changes</button>
        <a href="/user/profile">Cancel</a>
    </div>

    <div id="form-message" class="form-message" role="alert" hidden></div>

    {{#if error}}
        <div class="form-message" role="alert">{{error}}</div>
    {{/if}}
</form>