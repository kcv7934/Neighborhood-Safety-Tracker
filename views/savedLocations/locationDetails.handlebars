<h1>Saved Location Details</h1>

{{#if successMessage}}
  <p class="status-message">{{successMessage}}</p>
{{/if}}

<article class="location-details">
  <h2>{{location.label}}</h2>

  <p><strong>Address:</strong> {{location.address}}</p>

  <p><strong>Latitude:</strong> {{location.latitude}}</p>

  <p><strong>Longitude:</strong> {{location.longitude}}</p>

  {{#if location.tags.length}}
    <p><strong>Tags:</strong></p>

    <div class="tag-list">
      {{#each location.tags}}
        <span class="tag">{{this}}</span>
      {{/each}}
    </div>
  {{else}}
    <p>No tags</p>
  {{/if}}
</article>

<section class="nearby-filter-section">
  <h2>Filter Nearby Complaints</h2>

  <form id="nearby-report-filter-form" class="nearby-filter-form">

    <div class="filter-field">
      <label for="source">Report Source</label>
      <select id="source" name="source">
        <option value="all">All Reports</option>
        <option value="official">Official Reports</option>
        <option value="user">User Generated Reports</option>
      </select>
    </div>

    <div class="filter-field">
      <label for="report-category-fitler">Category</label>
      <select id="report-category-filter" name="category">
        <option value="">All categories</option>

        {{#each categories}}
          <option value="{{this}}">{{this}}</option>
        {{/each}}
      </select>
    </div>

    <div class="filter-field">
      <label for="report-start-date-filter">Start Date</label>
      <input type="date" id="report-start-date-filter" name="startDate" />
    </div>

    <div class="filter-field">
      <label for="report-end-date-filter">End Date</label>
      <input type="date" id="report-end-date-filter" name="endDate" />
    </div>

    <div class="filter-actions">
      <button type="submit" class="filter-button">Apply Filters</button>
      <button type="button" id="clear-report-filters" class="clear-button">Clear
        Filters</button>
    </div>
  </form>
</section>

<section class="map-section">
  <h2>Map</h2>

  <div
    id="saved-location-map"
    data-saved-location-id="{{location._id}}"
    data-latitude="{{location.latitude}}"
    data-longitude="{{location.longitude}}"
    data-label="{{location.label}}"
  ></div>

  <p id="map-message" class="form-message" role="alert" hidden></p>
</section>

<div class="page-actions">
  <a href="/saved-locations/{{location._id}}/edit" class="button-link">Edit
    Saved Location</a>
  <button
    type="button"
    id="delete-saved-location-button"
    value="{{location._id}}"
    class="delete-button"
  >Delete Saved Location</button>
  <a href="/saved-locations/my-locations">Back to My Saved Locations</a>
</div>

<div id="delete-message" class="form-message" role="alert" hidden></div>