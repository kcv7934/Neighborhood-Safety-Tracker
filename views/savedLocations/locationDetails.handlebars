<h1>Saved Location Details</h1>

{{#if successMessage}}
  <p>{{successMessage}}</p>
{{/if}}

<article>
  <h2>{{location.label}}</h2>

  <p>Address: {{location.address}}</p>

  <p>Latitude: {{location.latitude}}</p>

  <p>Longitude: {{location.longitude}}</p>

  {{#if location.tags.length}}
    <p>Tags:</p>

    <ul>
      {{#each location.tags}}
        <li>{{this}}</li>
      {{/each}}
    </ul>
  {{else}}
    <p>No tags</p>
  {{/if}}
</article>

<section>
  <h2>Filter Nearby User</h2>

  <form id="nearby-report-filter-form">
    <label for="report-category-fitler">Category</label>
    <select id="report-category-filter" name="category">
      <option value="">All categories</option>

      {{#each categories}}
        <option value="{{this}}">{{this}}</option>
      {{/each}}
    </select>

    <label for="report-start-date-filter">Start Date</label>
    <input type="date" id="report-start-date-filter" name="startDate" />

    <label for="report-end-date-filter">End Date</label>
    <input type="date" id="report-end-date-filter" name="endDate" />

    <button type="submit">Apply Filters</button>

    <button type="button" id="clear-report-filters">Clear Filters</button>
  </form>
</section>

<section>
  <h2>Map</h2>

  <div
    id="saved-location-map"
    data-saved-location-id="{{location._id}}"
    data-latitude="{{location.latitude}}"
    data-longitude="{{location.longitude}}"
    data-label="{{location.label}}"
  ></div>

  <p id="map-message" role="alert" hidden></p>
</section>

<p>
  <a href="/saved-locations/{{location._id}}/edit">Edit Saved Location</a>
</p>

<p>
  <button
    type="button"
    id="delete-saved-location-button"
    value="{{location._id}}"
  >Delete Saved Location</button>
</p>

<div id="delete-message" role="alert" hidden></div>

<p>
  <a href="/saved-locations/my-locations">Back to My Saved Locations</a>
</p>