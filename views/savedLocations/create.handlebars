<h1>Save a Location</h1>

<form id="create-saved-location-form" class="page-form">
  <div class="form-field">
    <label for="label">Label</label>
    <input type="text" id="label" name="label" maxlength="50" required />
  </div>

  <div class="form-field">
    <label for="address">Address</label>
    <input type="text" id="address" name="address" maxlength="50" value="{{address}}" required />
  </div>

  <div class="form-field">
    <label for="borough">Borough</label>
    <select id="borough" name="borough" required>
      <option value="">Select a borough</option>

      {{#each boroughs}}
        <option value="{{value}}" {{#if selected}}selected{{/if}}>
          {{value}}
        </option>
{{/each}}
    </select>
  </div>

  <div class="form-field">
    <label for="tags">Tags</label>
    <input type="text" id="tags" name="tags" />

    <p id="tags-help" class="form-help">
      Optional. Separate tags with commas, i.e. Home, Family, Downtown
    </p>
  </div>

  <div class="form-actions">
    <button type="submit">Save Location</button>
    <button type="button" id="cancel-save-location">Cancel</button>
  </div>

  <div id="form-message" class="form-message" role="alert" hidden></div>
</form>