<h1>My Saved Locations</h1>

{{#if successMessage}}
  <p class="status-message">{{successMessage}}</p>
{{/if}}

<p>
  <a class="button-link" href="/saved-locations/create">Save a New Location</a>
</p>

<form
  method="GET"
  action="/saved-locations/my-locations"
  class="location-filter-form"
>
  <div class="filter-field">
    <label for="tag-filter">Filter by tag</label>
    <input
      type="text"
      id="tag-filter"
      name="tag"
      value="{{selectedTag}}"
      maxLength="25"
      required
    />
  </div>

  <button class="filter-button" type="submit">Filter</button>

  <a class="clear-filter-link" href="/saved-locations/my-locations">Clear Filter</a>
</form>

{{#if mySavedLocations.length}}
  <div class="location-list">
    {{#each mySavedLocations}}
      <article class="location-card">
        <h2>{{label}}</h2>

        <p><strong>Address:</strong> {{address}}</p>

        {{#if tags.length}}
          <p><strong>Tags:</strong></p>

          <div class="tag-list">
            {{#each tags}}
              <span class="tag">{{this}}</span>
            {{/each}}
          </div>
        {{else}}
          <p>No tags</p>
        {{/if}}

        <div class="page-actions">
          <a href="/saved-locations/{{_id}}" class="button-link">View Location</a>
        </div>
      </article>
    {{/each}}
  </div>
{{else}}
  {{#if hasFilter}}
    <p>
      No saved locations were found with the tag "{{selectedTag}}".
    </p>
  {{else}}
    <p>You have not saved any locations yet.</p>
  {{/if}}
{{/if}}