<h1>Search Complaints</h1>

{{#if statusMessage}}
  <p class="status-message" role="status">
    {{statusMessage}}
  </p>
{{/if}}

<form id="complaint-search-form">
  <div class="form-field">
    <label for="source">Report Source:</label>
    <select id="source" name="source">
      <option value="all">All</option>
      <option value="official">Official Reports</option>
      <option value="user">User Reports</option>
    </select>
  </div>

  <div class="form-field">
    <label for="borough">Borough:</label>
    <select id="borough" name="borough">
      <option value="">All Boroughs</option>

      {{#each boroughs}}
        <option value="{{this}}">{{this}}</option>
      {{/each}}
    </select>
  </div>

  <div class="form-field">
    <label for="precinct">Precinct:</label>
    <input type="number" id="precinct" name="precinct" min="1" max="999" />
  </div>

  <div class="form-field">
    <label for="category">Category:</label>
    <select id="category" name="category">
      <option value="">All Categories</option>

      {{#each categories}}
        <option value="{{this}}">{{this}}</option>
      {{/each}}

      {{#each officialOnlyCategories}}
        <option value="{{this}}" class="official-only-category" hidden>
          {{this}}
        </option>
      {{/each}}
    </select>
  </div>

  <div class="form-field">
    <label for="startDate">Start Date:</label>
    <input type="date" id="startDate" name="startDate" />
  </div>

  <div class="form-field">
    <label for="endDate">End Date:</label>
    <input type="date" id="endDate" name="endDate" />
  </div>

  <div class="form-field">
    <label for="sortBy">Sort By:</label>
    <select id="sortBy" name="sortBy">
      <option value="date">Date</option>
      <option value="borough">Borough</option>
      <option
        value="precinct"
        id="precinct-sort-option"
        hidden
      >Precinct</option>
    </select>
  </div>

  <div class="form-field">
    <label for="sortOrder">Sort Order:</label>
    <select id="sortOrder" name="sortOrder">
      <option value="desc">Descending</option>
      <option value="asc">Ascending</option>
    </select>
  </div>

  <div class="form-actions">
    <button type="submit">Search</button>
    <button type="button" id="clear-filters" class="clear-button">Clear Filters</button>
  </div>
</form>

<div id="search-errors"></div>

<p id="result-count"></p>

<div id="search-results"></div>

<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script src="/public/js/search.js"></script>