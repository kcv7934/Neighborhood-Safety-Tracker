<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{title}}</title>
    <link rel="stylesheet" href="/public/css/main.css" />

    {{#if leaflet}}
      <link
        rel="stylesheet"
        href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
        integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
        crossorigin=""
      />
    {{/if}}

    {{#if stylesheet}}
      <link rel="stylesheet" href="/public/css/{{stylesheet}}" />
    {{/if}}
  </head>
  <body>

    <div class="app-layout">
      <aside class="sidebar">
        <div class="sidebar-title">
          <a href="/">Neighborhood Safety Tracker</a>
        </div>

        <nav>
          <ul class="sidebar-nav">
            <li>
              <a href="/">Dashboard</a>
            </li>

            <li>
              <a href="/saved-locations/my-locations">Saved Locations</a>
            </li>

            <li>
              <a href="/saved-locations/create">Save a Location</a>
            </li>

            <li>
              <a href="/user-reports/my-reports">My Reports</a>
            </li>

            <li>
              <a href="/user-reports/create">Create a Report</a>
            </li>

            <li>
              <a href="/official-reports">View Official Reports</a>
            </li>
          </ul>
        </nav>
      </aside>

      <div class="app-content">
        {{{body}}}
      </div>
    </div>

    {{#if partial}}
      {{> (lookup . "partial")}}
    {{/if}}
  </body>
</html>